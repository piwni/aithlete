# Copy to .env and fill in. Never commit .env.

# --- intervals.icu (canonical source for activities, load, curves) ---
# Personal API key: intervals.icu -> Settings -> Developer Settings.
# Athlete id can stay as 0 to mean "the athlete this key belongs to".
INTERVALS_API_KEY=
INTERVALS_ATHLETE_ID=0

# --- Open Wearables (canonical for recovery/sleep/HRV from Oura/Whoop) ---
# Deferred for v1. Self-host: https://github.com/the-momentum/open-wearables
OPEN_WEARABLES_BASE_URL=http://localhost:8000/api/v1
OPEN_WEARABLES_API_KEY=
OPEN_WEARABLES_USER_ID=

# --- Behaviour ---
# When true, connectors read from recorded fixtures instead of the network.
# Lets the whole pipeline run offline with no accounts/keys.
AITHLETE_OFFLINE=true

# Root for persisted data (profiles, plans, raw, context). Defaults to ./data
AITHLETE_DATA_DIR=
